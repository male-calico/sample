"""
複数AI(Claude / ChatGPT / Gemini)を一つの窓口から呼び分ける
シンプルなルーターのサンプルコード。

note記事の「Claude Code + MCP」方式と考え方は同じで、
違いは「各社の公式APIを直接叩く」という点だけ。
Claude Code や MCP ツールを経由せず、これ単体で動く。

事前準備:
    pip install anthropic openai google-genai

    環境変数に各社のAPIキーをセットしておく
    (PowerShellの例: $env:ANTHROPIC_API_KEY="xxxx")
        ANTHROPIC_API_KEY   … https://console.anthropic.com で発行
        OPENAI_API_KEY      … https://platform.openai.com で発行
        GEMINI_API_KEY      … https://aistudio.google.com/apikey で発行

    注意: ここでのAPI利用は、ChatGPT Plus/Claude Pro/Gemini Advanced
    などのサブスク契約とは別会計の従量課金になる。
    モデル名は執筆時点のものなので、実行前に各社の最新モデル一覧を確認すること。
"""

import os
from anthropic import Anthropic
from openai import OpenAI
from google import genai

# --- 各社クライアントの初期化 ---
claude_client = Anthropic(api_key=os.environ.get("ANTHROPIC_API_KEY"))
openai_client = OpenAI(api_key=os.environ.get("OPENAI_API_KEY"))
gemini_client = genai.Client(api_key=os.environ.get("GEMINI_API_KEY"))


# --- 各社への問い合わせ関数 ---
def ask_claude(prompt: str) -> str:
    response = claude_client.messages.create(
        model="claude-sonnet-5",
        max_tokens=1024,
        messages=[{"role": "user", "content": prompt}],
    )
    return response.content[0].text


def ask_chatgpt(prompt: str) -> str:
    response = openai_client.chat.completions.create(
        model="gpt-4o",  # 要確認: OpenAIの最新モデル名に置き換える
        messages=[{"role": "user", "content": prompt}],
    )
    return response.choices[0].message.content


def ask_gemini(prompt: str) -> str:
    response = gemini_client.models.generate_content(
        model="gemini-2.5-flash",  # 要確認: Googleの最新モデル名に置き換える
        contents=prompt,
    )
    return response.text


# --- ルーティング方式①: ルールベース ---
# note記事のCLAUDE.mdに書かれていたルールを、そのままコードに落とした版
def route_by_rule(prompt: str) -> str:
    if any(k in prompt for k in ["調べて", "検索して", "最新情報"]):
        return "gemini"
    if any(k in prompt for k in ["文章を書いて", "作成して"]):
        return "chatgpt"
    return "claude"


# --- ルーティング方式②: LLM判定ベース ---
# ルールに当てはまらない曖昧な依頼は、軽量モデルに判定させる
def route_by_llm(prompt: str) -> str:
    judge_prompt = (
        "次の依頼はどのAIに任せるのが最適か、"
        "claude / chatgpt / gemini のいずれか一語だけで答えてください。\n\n"
        f"依頼: {prompt}"
    )
    response = claude_client.messages.create(
        model="claude-haiku-4-5-20251001",
        max_tokens=10,
        messages=[{"role": "user", "content": judge_prompt}],
    )
    return response.content[0].text.strip().lower()


# --- 統合窓口 ---
def ask(prompt: str, mode: str = "rule") -> str:
    target = route_by_rule(prompt) if mode == "rule" else route_by_llm(prompt)

    handlers = {
        "claude": ask_claude,
        "chatgpt": ask_chatgpt,
        "gemini": ask_gemini,
    }
    handler = handlers.get(target, ask_claude)
    print(f"[振り分け結果: {target}]")
    return handler(prompt)


if __name__ == "__main__":
    result = ask("今日のAI関連の最新情報を調べてください")
    print(result)